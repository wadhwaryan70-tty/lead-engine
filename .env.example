# Copy this file to .env and paste your keys in.
# Open roles with posting dates (theirstack.com -> Settings -> API key)
THEIRSTACK_API_KEY=
# Decision-maker emails and LinkedIn profiles (apollo.io -> Settings -> Integrations -> API)
APOLLO_API_KEY=
# Free backup job source (developer.adzuna.com -> Register -> Dashboard -> API access details)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Writes the emails and LinkedIn messages (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Optional second key, used if the first hits its rate limit
GEMINI_API_KEY_BACKUP=
